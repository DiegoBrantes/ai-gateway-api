{
  "name": "ai-gateway-api",
  "version": "1.1.0",
  "description": "Unified, provider-agnostic gateway for OpenAI, Google Gemini and Anthropic — one API, automatic fallback, streaming, token accounting and cost estimation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --clean --target node20 --sourcemap",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "ai",
    "gateway",
    "llm",
    "openai",
    "gemini",
    "anthropic",
    "fastify",
    "typescript",
    "streaming",
    "api"
  ],
  "author": "Diego de Carvalho Brantes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiegoBrantes/ai-gateway-api.git"
  },
  "homepage": "https://github.com/DiegoBrantes/ai-gateway-api#readme",
  "bugs": {
    "url": "https://github.com/DiegoBrantes/ai-gateway-api/issues"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.7",
    "tsup": "^8.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@fastify/static": "^10.1.2",
    "esbuild": "^0.28.1",
    "brace-expansion": "^5.0.8"
  }
}
