# ─────────────────────────────────────────────────────────────
#  AI Gateway API — environment configuration
#  Copy this file to `.env` and fill in the values you need.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Security ────────────────────────────────────────────────────
# Comma-separated list of API keys accepted by the gateway.
# Each incoming request must send one of these in `x-api-key`.
API_KEYS=dev-key-please-change

# Optional separate admin key for the dashboard/metrics when they are protected.
ADMIN_API_KEY=

# Secret used to sign/verify JWTs (optional auth mode).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# Operational surface ─────────────────────────────────────────
# /dashboard and /metrics/summary expose aggregate usage/cost.
# Unset → public in dev/test, protected in production. Set true/false to force.
DASHBOARD_PUBLIC=
# Swagger UI (static assets). The OpenAPI JSON at /openapi.json is always served.
# Unset → on in dev, off in production.
ENABLE_SWAGGER_UI=
# Explicitly allow the mock provider in production (otherwise the app refuses to
# boot in production with no real provider configured).
ALLOW_MOCK_PROVIDER=

# Rate limiting ───────────────────────────────────────────────
RATE_LIMIT_MAX=60          # max requests...
RATE_LIMIT_WINDOW_MS=60000 # ...per this window (ms) per API key

# Cache ───────────────────────────────────────────────────────
# Leave REDIS_URL empty to use the built-in in-memory cache.
REDIS_URL=
CACHE_TTL_SECONDS=300
# Cache isolation: `principal` (default) keys the cache per caller so responses
# are never shared across API keys; `global` shares one cache for everyone.
CACHE_SCOPE=principal
# Hard cap on the in-memory cache (LRU eviction beyond this many entries).
MEMORY_CACHE_MAX_ENTRIES=10000

# Provider selection ──────────────────────────────────────────
# Default provider when the caller does not specify one.
DEFAULT_PROVIDER=openai
# Ordered fallback chain, comma-separated. If the primary provider
# fails, the gateway transparently retries the next one.
FALLBACK_PROVIDERS=anthropic,gemini

# Provider credentials (only the ones you configure are enabled) ─
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Resilience ──────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=30000
PROVIDER_MAX_RETRIES=2
